    {
        "id": "073c5f69ebaafe54",
        "type": "function",
        "z": "5beda5fc7aeb1538",
        "name": "Split Weather Data",
        "func": "// Check for errors\nif (!msg.payload || msg.payload.error) {\n    node.warn('API Error: ' + (msg.payload?.error || 'No data'));\n    return null;\n}\n\nconst data = msg.payload;\n\n// Store complete data\nflow.set('weatherData', data);\nflow.set('lastUpdate', new Date().toLocaleString());\n\n// Output 1: Current Weather Data\nlet currentMsg = {\n    payload: data.current_weather,\n    city: msg.city\n};\n\n// Output 2: Forecast Data\nlet forecastMsg = {\n    payload: data.forecast,\n    city: msg.city\n};\n\n// Output 3: Statistics for Historical\nlet statsMsg = {\n    payload: data.statistics,\n    currentWeather: data.current_weather,\n    city: msg.city\n};\n\nreturn [currentMsg, forecastMsg, statsMsg];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
