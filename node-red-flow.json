    {
        "id": "bf0d6def7a59e5ff",
        "type": "function",
        "z": "5beda5fc7aeb1538",
        "name": "Store Historical Data",
        "func": "// Get historical data and last tracked city\nlet history = flow.get('weatherHistory') || [];\nlet lastCity = flow.get('lastTrackedCity') || null;\n\nconst currentWeather = msg.currentWeather;\nif (currentWeather && currentWeather.current) {\n    const timestamp = new Date();\n    const city = msg.city || 'Unknown';\n\n    // Check if city has changed - if so, reset history\n    if (lastCity && lastCity !== city) {\n        // Clear chart by sending empty array\n        let clearMsg = {\n            payload: [],\n            topic: 'Temperature'\n        };\n        node.send([clearMsg, null]);\n\n        // Reset history for new city\n        history = [];\n        node.warn(`City changed from ${lastCity} to ${city}. Resetting historical data.`);\n    }\n\n    // Update last tracked city\n    flow.set('lastTrackedCity', city);\n\n    const entry = {\n        timestamp: timestamp.getTime(),\n        datetime: timestamp.toLocaleString(),\n        city: city,\n        temperature: currentWeather.current.temperature,\n        humidity: currentWeather.current.humidity,\n        pressure: currentWeather.current.pressure,\n        wind_speed: currentWeather.wind.speed\n    };\n\n    history.push(entry);\n\n    // Keep last 100 entries total\n    history = history.slice(-100);\n\n    flow.set('weatherHistory', history);\n\n    // Filter history for current city only\n    const cityHistory = history.filter(h => h.city === city).slice(-20);\n\n    // Output 1: Chart data (formatted for ui_chart)\n    let chartMsg = {\n        payload: currentWeather.current.temperature,\n        topic: 'Temperature',\n        city: city\n    };\n\n    // Output 2: Stats data (array of history for current city)\n    let statsMsg = {\n        payload: cityHistory,\n        city: city\n    };\n\n    return [chartMsg, statsMsg];\n}\n\nreturn null;",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
