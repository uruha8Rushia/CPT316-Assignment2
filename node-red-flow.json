        "height": 5,
        "format": "<div style=\"padding: 15px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 16px; color: white; margin-bottom: 0px\">\n    <div style=\"margin: 0 0 10px 0; font-size: 24px; font-weight: bold;\">{{msg.payload.location.city}}, {{msg.payload.location.country}}</div>\n    <div style=\"display: flex; align-items: center; margin: 15px 0;\">\n        <img src=\"http://openweathermap.org/img/wn/{{msg.payload.current.icon}}@2x.png\" style=\"width: 80px; height: 80px;\">\n        <div style=\"margin-left: 20px;\">\n            <div style=\"font-size: 42px; font-weight: bold;\">{{msg.payload.current.temperature}}°C</div>\n            <div style=\"font-size: 16px; text-transform: capitalize; opacity: 0.9;\">{{msg.payload.current.description}}</div>\n        </div>\n    </div>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 14px;\">\n        <div><strong>Feels Like:</strong> {{msg.payload.current.feels_like}}°C</div>\n        <div><strong>Min/Max:</strong> {{msg.payload.current.temp_min}}° / {{msg.payload.current.temp_max}}°</div>\n        <div><strong>Sunrise:</strong> {{msg.payload.sunrise}}</div>\n        <div><strong>Sunset:</strong> {{msg.payload.sunset}}</div>\n    </div>\n    <div style=\"margin-top: 10px; font-size: 11px; opacity: 0.8;\">Updated: {{msg.payload.timestamp}}</div>\n</div>",
        "storeOutMessages": false,
