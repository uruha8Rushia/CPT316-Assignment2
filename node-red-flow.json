    {
        "id": "ba9f609aa3277cf1",
        "type": "function",
        "z": "7a2819d05f5f4e5c",
        "name": "check temperature",
        "func": "const temp = msg.payload.current.temperature;\nconst city = msg.city || 'Unknown';\n\n// Define thresholds\nconst highTempThreshold = 35;\nconst lowTempThreshold = 0;\n\nif (temp >= highTempThreshold) {\n    msg.payload = `High Temperature Alert: ${temp}°C in ${city}!`;\n    msg.topic = 'warning';\n    return msg;\n} else if (temp <= lowTempThreshold) {\n    msg.payload = `Low Temperature Alert: ${temp}°C in ${city}!`;\n    msg.topic = 'warning';\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1310,
        "y": 380,
