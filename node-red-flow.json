    {
        "id": "595f9af0b798a583",
        "type": "function",
        "z": "5beda5fc7aeb1538",
        "name": "Calculate Historical Stats",
        "func": "if (!msg.payload || msg.payload.length === 0) {\n    return null;\n}\n\nconst temps = msg.payload.map(e => e.temperature);\nconst humidities = msg.payload.map(e => e.humidity);\n\nmsg.payload = {\n    city: msg.city,\n    data_points: msg.payload.length,\n    temperature: {\n        avg: (temps.reduce((a, b) => a + b, 0) / temps.length).toFixed(1),\n        max: Math.max(...temps).toFixed(1),\n        min: Math.min(...temps).toFixed(1)\n    },\n    humidity: {\n        avg: (humidities.reduce((a, b) => a + b, 0) / humidities.length).toFixed(1)\n    }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1610,
        "y": 760,
