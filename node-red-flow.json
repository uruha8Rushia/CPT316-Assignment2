    {
        "id": "fa545de0230115e9",
        "type": "ui_template",
        "z": "5beda5fc7aeb1538",
        "group": "0b0f3587ded3510d",
        "name": "Forecast Table",
        "order": 1,
        "width": "12",
        "height": "11",
        "format": "<div style=\"padding: 10px;\">\n    <table style=\"width: 100%; border-collapse: collapse; font-family: Arial;\">\n        <thead>\n            <tr style=\"background-color: #1976d2; color: white;\">\n                <th style=\"padding: 12px; text-align: left;\">Date</th>\n                <th style=\"padding: 12px; text-align: center;\">Weather</th>\n                <th style=\"padding: 12px; text-align: center;\">Description</th>\n                <th style=\"padding: 12px; text-align: center;\">Temperature (°C)</th>\n            </tr>\n        </thead>\n        <tbody>\n            <tr ng-repeat=\"day in msg.payload.daily_summary\" style=\"border-bottom: 1px solid #ddd;\">\n                <td style=\"padding: 12px; font-weight: 500;\">{{day.date}}</td>\n                <td style=\"padding: 12px; text-align: center;\">\n                    <img src=\"http://openweathermap.org/img/wn/{{day.icon}}@2x.png\" style=\"width: 50px; height: 50px;\">\n                </td>\n                <td style=\"padding: 12px; text-align: center; text-transform: capitalize;\">{{day.description}}</td>\n                <td style=\"padding: 12px; text-align: center;\">\n                    <span style=\"color: #2196f3; font-weight: bold;\">{{day.temp_min}}°</span>\n                    <span style=\"margin: 0 5px;\">/</span>\n                    <span style=\"font-weight: bold;\">{{day.temp_avg}}°</span>\n                    <span style=\"margin: 0 5px;\">/</span>\n                    <span style=\"color: #f44336; font-weight: bold;\">{{day.temp_max}}°</span>\n                </td>\n            </tr>\n        </tbody>\n    </table>\n</div>",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": false,
        "templateScope": "local",
