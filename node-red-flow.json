        "order": 4,
        "width": 5,
        "height": 7,
        "format": "<div style=\"margin-right:10px;\">\n    <h3 style=\"margin-bottom:12px;\">Statistics</h3>\n    <div ng-if=\"msg.payload\">\n        <div style=\"margin-bottom: 20px; padding: 15px; background: #e3f2fd; border-radius: 8px; border-left: 4px solid #1976d2;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Average Temperature</div>\n            <div style=\"font-size: 24px; font-weight: bold; color: #1976d2;\">{{msg.payload.temperature.avg}}°C</div>\n        </div>\n        <div style=\"margin-bottom: 20px; padding: 15px; background: #fff3e0; border-radius: 8px; border-left: 4px solid #f57c00;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Maximum Temperature</div>\n            <div style=\"font-size: 24px; font-weight: bold; color: #f57c00;\">{{msg.payload.temperature.max}}°C</div>\n        </div>\n        <div style=\"padding: 15px; background: #e0f2f1; border-radius: 8px; border-left: 4px solid #00796b;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Minimum Temperature</div>\n            <div style=\"font-size: 24px; font-weight: bold; color: #00796b;\">{{msg.payload.temperature.min}}°C</div>\n        </div>\n    </div>\n    <div ng-if=\"!msg.payload\" style=\"color: #999; text-align: center; padding: 40px 20px;\">\n        <div style=\"font-size: 48px; margin-bottom: 10px;\">📊</div>\n        <div>No historical data yet</div>\n        <div style=\"font-size: 12px; margin-top: 5px;\">Refresh to collect data</div>\n    </div>\n</div>",
