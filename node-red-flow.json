    {
        "id": "999a8e1e1ef10ea1",
        "type": "function",
        "z": "d08d6816c25f86a0",
        "name": "Format Export Data",
        "func": "// Get data and view mode\nconst data = flow.get('historicalData');\nconst viewMode = flow.get('historyViewMode') || '7d';\nconst city = flow.get('currentCity') || 'Unknown';\n\nif (!data || !data.hourly) {\n    return null;\n}\n\nlet hourly = data.hourly;\n\n// Filter based on view mode (same logic as Process History)\nconst now = new Date().getTime();\nif (viewMode === '24h') {\n    const cutoff = now - (24 * 60 * 60 * 1000);\n    hourly = hourly.filter(h => new Date(h.timestamp).getTime() > cutoff);\n} else if (viewMode === '7d') {\n    const cutoff = now - (7 * 24 * 60 * 60 * 1000);\n    hourly = hourly.filter(h => new Date(h.timestamp).getTime() > cutoff);\n}\n\n// Create CSV\nlet csv = \"Timestamp,Date,Time,Temperature(C),Humidity(%),Pressure(hPa),Wind Speed(m/s)\\n\";\n\nhourly.forEach(h => {\n    const dt = new Date(h.timestamp);\n    csv += `${h.timestamp},${dt.toLocaleDateString()},${dt.toLocaleTimeString()},${h.temperature},${h.humidity},${h.pressure},${h.wind_speed}\\n`;\n});\n\nmsg.payload = csv;\nmsg.filename = `history_${city}_${viewMode}.csv`; // For file node\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 1330,
        "y": 860,
