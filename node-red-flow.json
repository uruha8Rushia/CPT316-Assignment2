    {
        "id": "f1ef0b3c17604be5",
        "type": "function",
        "z": "d08d6816c25f86a0",
        "name": "Format CSV",
        "func": "// Get the stored weather data\nconst weatherData = flow.get('weatherData');\n\nif (!weatherData || !weatherData.current_weather) {\n    return null;\n}\n\nconst current = weatherData.current_weather.current;\nconst wind = weatherData.current_weather.wind;\n\nconst entry = {\n    timestamp: new Date().getTime(),\n    datetime: new Date().toLocaleString(),\n    city: msg.city || 'Unknown',\n    temperature: current.temperature,\n    humidity: current.humidity,\n    pressure: current.pressure,\n    wind_speed: wind.speed\n};\n\nmsg.payload = `${entry.timestamp},\"${entry.datetime}\",${entry.city},${entry.temperature},${entry.humidity},${entry.pressure},${entry.wind_speed}`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1590,
        "y": 840,
