        "group": "caa6853f5a10dd4f",
        "name": "Historical Statistics",
        "order": 2,
        "width": "4",
        "height": "10",
        "format": "<div style=\"padding: 15px; font-family: Arial;\">\n    <h3 style=\"margin-top: 0; color: #1976d2;\">📊 Statistics</h3>\n    <div ng-if=\"msg.payload\">\n        <div style=\"margin-bottom: 15px; padding: 15px; background: #e3f2fd; border-radius: 8px; border-left: 4px solid #1976d2;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Average Temperature</div>\n            <div style=\"font-size: 28px; font-weight: bold; color: #1976d2;\">{{msg.payload.temperature.avg}}°C</div>\n        </div>\n        <div style=\"margin-bottom: 15px; padding: 15px; background: #fff3e0; border-radius: 8px; border-left: 4px solid #f57c00;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Maximum Temperature</div>\n            <div style=\"font-size: 28px; font-weight: bold; color: #f57c00;\">{{msg.payload.temperature.max}}°C</div>\n        </div>\n        <div style=\"margin-bottom: 15px; padding: 15px; background: #e0f2f1; border-radius: 8px; border-left: 4px solid #00796b;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Minimum Temperature</div>\n            <div style=\"font-size: 28px; font-weight: bold; color: #00796b;\">{{msg.payload.temperature.min}}°C</div>\n        </div>\n        <div style=\"padding: 15px; background: #f3e5f5; border-radius: 8px; border-left: 4px solid #7b1fa2;\">\n            <div style=\"font-size: 12px; color: #666; margin-bottom: 5px;\">Data Points</div>\n            <div style=\"font-size: 28px; font-weight: bold; color: #7b1fa2;\">{{msg.payload.data_points}}</div>\n        </div>\n    </div>\n    <div ng-if=\"!msg.payload\" style=\"color: #999; text-align: center; padding: 40px 20px;\">\n        <div style=\"font-size: 48px; margin-bottom: 10px;\">📊</div>\n        <div>No historical data yet</div>\n        <div style=\"font-size: 12px; margin-top: 5px;\">Refresh to collect data</div>\n    </div>\n</div>",
