    {
        "id": "3e3aec65f192572d",
        "type": "function",
        "z": "d08d6816c25f86a0",
        "name": "Split Weather Data",
        "func": "// Check for errors\nif (!msg.payload || msg.payload.error) {\n    node.warn('API Error: ' + (msg.payload?.error || 'No data'));\n    return null;\n}\n\nconst data = msg.payload;\n\n// Store complete data\nflow.set('weatherData', data);\nflow.set('lastUpdate', new Date().toLocaleString());\n\n// Output 1: Current Weather Data\nlet currentMsg = {\n    payload: data.current_weather,\n    city: msg.city\n};\n\n// Output 2: Forecast Data\nlet forecastMsg = {\n    payload: data.forecast,\n    city: msg.city\n};\n\n// Output 3: Historical Data (From API)\nlet historyMsg = {\n    payload: data.historical,\n    city: msg.city\n};\n\nreturn [currentMsg, forecastMsg, historyMsg];",
        "outputs": 3,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
