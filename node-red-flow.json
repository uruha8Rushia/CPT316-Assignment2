    {
        "id": "9d3970b5b85a4190",
        "type": "function",
        "z": "d08d6816c25f86a0",
        "name": "Build URL",
        "func": "// Get city from input, stored city, or default\nlet city = msg.payload;\n\n// Ensure city is a string, if not (e.g. object from ui_control), treat as empty\nif (typeof city !== 'string') {\n    city = '';\n}\n\n// If payload is \"refresh\" or empty, use stored city\nif (!city || city === \"refresh\" || city.trim() === \"\") {\n    city = flow.get('currentCity') || 'Penang';\n}\n\n// Store current city\nflow.set('currentCity', city);\n\n// Build API URL\nmsg.url = `http://127.0.0.1:5000/api/weather/complete?city=${encodeURIComponent(city)}`;\nmsg.city = city;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
